<Window x:Class="FastClose.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭器" 
        Height="100" 
        Width="100"
        WindowStyle="ToolWindow"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Icon="logo.ico"
        Loaded="Window_Loaded"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp">
    <!-- 外层 Grid 铺满，让红色区域始终保持为正方形 -->
    <Grid x:Name="RootGrid" Margin="6">
        <!-- 主关闭按钮 -->
        <Button x:Name="BtnCloseTarget" 
                Content="关闭目标" 
                FontSize="16" 
                FontWeight="Bold"
                Foreground="White"
                Background="#C42B1C"
                BorderThickness="0"
                Click="BtnCloseTarget_Click"/>
    </Grid>
</Window>